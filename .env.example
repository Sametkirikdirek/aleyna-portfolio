# Firebase Ortam Değişkenleri (İstemci)
# Bu değerleri Firebase Console > Project Settings > Your Apps bölümünden alın.
# Gerçek değerleri .env.local dosyasına kopyalayın (bu dosyayı asla git'e commit etmeyin!)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Cloudinary Ortam Değişkenleri (Yalnızca Sunucu Tarafı - /api/upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Telegram Bildirim Hattı
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_from_userinfobot

# Security hardening: Vercel Server-side Environment Variables
# Same Firebase web API key as VITE_FIREBASE_API_KEY, but made available to the server
FIREBASE_API_KEY=your_firebase_web_api_key_here
# Comma-separated approved staff emails; include the artist and moderator accounts
ADMIN_UPLOAD_EMAILS=artist@example.com,moderator@example.com
# Comma-separated approved moderator emails; only these may test Telegram notifications
ADMIN_MODERATOR_EMAILS=moderator@example.com

# NEVER store a Telegram bot token in Firestore public content, frontend files,
# git history, Antigravity chat, or a browser. Use Vercel env secrets only.
