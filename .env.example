# Firebase Ortam Değişkenleri (İstemci)
# Bu değerleri Firebase Console > Project Settings > Your Apps bölümünden alın.
# Gerçek değerleri .env.local dosyasına kopyalayın (bu dosyayı asla git'e commit etmeyin!)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Cloudinary Ortam Değişkenleri (Yalnızca Sunucu Tarafı - /api/upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
