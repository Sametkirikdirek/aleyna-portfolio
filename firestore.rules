rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Ziyaretçi Trafik & Analitik Sayacı
    // Ziyaretçiler yalnızca sayaç artırma işlemi yapabilir; okuma ve silme adminlere özeldir.
    match /analytics/traffic {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // 2. Portfolyo İçerikleri (Profil, Galeri, Yazılar, Zaman Yolculuğu, CV, Projeler)
    // - Okuma: Herkese açık (Ziyaretçiler portfolyoyu görebilir)
    // - Yazma/Güncelleme/Silme: YALNIZCA oturum açmış yetkili kullanıcı (request.auth != null)
    match /content/{documentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Özel Tuval Talepleri
    // - Ziyaretçi: Yalnızca yeni sipariş oluşturabilir (create), başkalarının siparişlerini okuyamaz, değiştiremez veya silemez.
    // - Yetkili (Admin/Moderatör): Tam yetkili (read, update, delete).
    match /commission_requests/{requestId} {
      allow create: if request.resource.data.status == "mod_pending";
      allow read, update, delete: if request.auth != null;
    }

    // 4. Adli Güvenlik Kayıtları & Siber İhbar Havuzu
    // - Ziyaretçilere tamamen kapalıdır.
    // - Yalnızca oturum açmış Moderatör / Admin inceleyebilir.
    match /incident_logs/{incidentId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 5. Sistem & Bot Ayarları (Telegram Token, Chat ID, Rol Yetkileri)
    // - Dış dünyaya ve ziyaretçilere TAMAMEN KAPALI.
    // - Yalnızca oturum açmış yetkili kullanıcı okuyabilir ve güncelleyebilir.
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // 6. Geri Kalan Tüm Dokümanlar Varsayılan Olarak Tamamen Kilitli
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
